# Optional. The app needs no secrets to run.
# A Hugging Face token only raises rate limits for the one-time download of the
# embedding model (all-MiniLM-L6-v2) and silences the "unauthenticated requests"
# warning. huggingface_hub reads it from the environment, e.g.:
#   export HF_TOKEN=hf_your_token_here
HF_TOKEN=
